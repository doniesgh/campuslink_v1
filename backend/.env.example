# CampusLink API. Copy to backend/.env (git-ignored). Variables already set in the shell take precedence.

# --- Required ---
# MongoDB connection string (local server or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/campuslink
# Secret used to sign the access tokens: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Server ---
PORT=4000
# Origins allowed by CORS and by the real-time (Socket.IO) layer, comma-separated.
CORS_ORIGINS=http://localhost:3000
# Who may set X-Forwarded-For (Express "trust proxy"): the Next.js BFF runs on this host.
TRUST_PROXY=loopback
# Public URL of this API (absolute links) and of the web app (links in emails).
PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000
# Campus timezone of every "per day / per week" computation.
APP_TIMEZONE=Africa/Tunis

# --- Tokens ---
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_MAX_ATTEMPTS=5

# --- Email (2FA codes, password reset). Brevo (HTTPS API) when BREVO_API_KEY and MAIL_FROM_EMAIL are set: use it
# on hosts that block SMTP ports (Render's free plan). Otherwise SMTP; with neither, emails are not sent (development).
BREVO_API_KEY=
# A sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CampusLink
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Also write every email as a JSON line to this file (tests read OTP codes from it).
MAIL_OUTBOX_FILE=

# --- AI (optional): the smart import of users, through OpenRouter (https://openrouter.ai/keys). Off when empty.
OPENROUTER_API_KEY=
# One model, or several separated by commas (the next ones are tried when one is busy or down). Free, without
# credits (50 requests a day): nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Only providers that don't store or train on the data are used; true also allows the others (free models need it).
OPENROUTER_ALLOW_DATA_COLLECTION=false

# --- Web push (optional). Generate a pair with: npm run generate-vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campuslink.local
# Write pushes as JSON lines to this file instead of sending them (tests).
PUSH_OUTBOX_FILE=

# --- Rate limits (per instance, in memory) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_PASSWORD_MAX=10
RATE_LIMIT_RESET_MAX=20
# Smart-import AI analyses per admin and hour.
RATE_LIMIT_AI_MAX=30

# --- Files and jobs ---
# Uploaded files: "disk" (STORAGE_DIR, default backend/uploads) or "gridfs" (MongoDB).
STORAGE_DRIVER=disk
STORAGE_DIR=
MAX_UPLOAD_MB=10
SCHEDULER_INTERVAL_MS=30000
